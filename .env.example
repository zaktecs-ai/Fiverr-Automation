# ─────────────────────────────────────────────────────────────
# SECRETS / CREDENTIALS  —  copy this file to `.env`
# `.env` is git-ignored. Never commit real values.
# Values here are loaded as environment variables and can also be
# referenced from config.yaml using ${VAR_NAME} substitution.
# ─────────────────────────────────────────────────────────────

# (Optional) A static proxy URL for the experimental proxy support.
# Leave empty — proxy support is disabled by default.
# HTTP_PROXY=
# HTTPS_PROXY=

# (Optional) Future provider API key — placeholder only.
# PROVIDER_API_KEY=
